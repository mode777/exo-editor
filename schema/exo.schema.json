{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exo:schema:v1",
  "title": "Exo workspace and plugin manifests (v1)",
  "description": "Shared shape for exo.json and exo-manifest.json. Semantic rules that JSON Schema cannot express - duplicate manifest URLs, origin equality, plugin-root containment, engine compatibility and consent - are enforced by the validator and specified in docs/contracts/plugin-manifest.md.",
  "oneOf": [{ "$ref": "#/$defs/exoFile" }, { "$ref": "#/$defs/exoManifest" }],
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s@#]+$"
    },
    "manifestUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?:https://[^\\s@#]+|http://localhost(?::[0-9]{1,5})?(?:/[^\\s@#]*)?)$"
    },
    "relativePage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?#\\u0000]).+\\.[Hh][Tt][Mm][Ll]?$"
    },
    "relativeAsset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[?#\\u0000]).+$"
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!^!)(?!.*\\.\\.)(?!.*[\\\\\\u0000]).{1,200}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": { "$ref": "#/$defs/manifestUrl" },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "fileEditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glob", "entry", "label"],
      "properties": {
        "glob": { "$ref": "#/$defs/glob" },
        "entry": { "$ref": "#/$defs/relativePage" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        },
        "rendering": {
          "enum": ["hidden", "frame"],
          "default": "hidden"
        },
        "companionPanels": { "$ref": "#/$defs/companionPanels" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "location", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$"
        },
        "location": { "enum": ["primary", "secondary", "bottom"] },
        "entry": { "$ref": "#/$defs/relativePage" }
      }
    },
    "contentView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "entry": { "$ref": "#/$defs/relativePage" },
        "companionPanel": { "$ref": "#/$defs/contributionId" },
        "companionPanels": { "$ref": "#/$defs/companionPanels" }
      }
    },
    "commandTarget": {
      "oneOf": [
        { "const": "activeEditor" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "panel" },
            "id": { "$ref": "#/$defs/contributionId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "contentView" },
            "id": { "$ref": "#/$defs/contributionId" }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "target": { "$ref": "#/$defs/commandTarget" },
        "menus": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["commandPalette", "explorer/context", "editor/title"] },
          "$comment": "editor/title requires an activeEditor target and explorer/context requires a panel or content-view target; the validator enforces the pairing."
        }
      }
    },
    "newFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "fileName", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\\\u0000]+$",
          "$comment": "One path segment; the validator also rejects \".\", \"..\", exo.json and .exo."
        },
        "encoding": { "enum": ["utf8", "base64"] },
        "content": {
          "type": "string",
          "$comment": "At most 64 KiB after decoding, 128 KiB per plugin in total; the validator decodes and enforces it."
        }
      }
    },
    "settingKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-zA-Z0-9]*(?:[.-][a-zA-Z0-9]+)*$"
    },
    "settingValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "maxLength": 4096 },
        { "type": "number" }
      ]
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": { "enum": ["boolean", "string", "number"] },
        "default": { "$ref": "#/$defs/settingValue" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/settingValue" }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "scope": { "const": "workspace" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties"],
      "properties": {
        "properties": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": { "$ref": "#/$defs/settingKey" },
          "additionalProperties": { "$ref": "#/$defs/setting" }
        }
      }
    },
    "contributionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "companionPanels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contributionId" }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileEditors": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/fileEditor" }
        },
        "panels": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/panel" }
        },
        "contentViews": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/contentView" }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/command" }
        },
        "newFiles": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/newFile" }
        },
        "configuration": { "$ref": "#/$defs/configuration" }
      }
    },
    "exoFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "plugins"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "plugins": {
          "type": "array",
          "maxItems": 50,
          "$comment": "Duplicate manifest URLs are rejected by the validator; JSON Schema cannot express uniqueness of a property across array items.",
          "items": { "$ref": "#/$defs/pluginEntry" }
        }
      }
    },
    "exoManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "name",
        "version",
        "publisher",
        "engines",
        "runtime",
        "permissions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "publisher": { "$ref": "#/$defs/publisher" },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "icon": {
          "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "$ref": "#/$defs/relativeAsset" }]
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exo"],
          "properties": {
            "exo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry"],
          "properties": {
            "entry": { "$ref": "#/$defs/relativePage" }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["workspace:read", "workspace:write", "workspace:list", "events:subscribe"]
          },
          "$comment": "workspace:write and workspace:list without workspace:read are rejected by the validator; JSON Schema cannot express those dependencies cleanly."
        },
        "contributes": { "$ref": "#/$defs/contributes" }
      }
    }
  }
}
