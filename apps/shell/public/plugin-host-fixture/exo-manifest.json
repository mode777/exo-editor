{
  "schemaVersion": 1,
  "id": "com.example.exo.fixture",
  "name": "Exo Host Fixture",
  "version": "1.2.0",
  "description": "A stub plugin used to verify the Exo plugin host and file editors.",
  "publisher": {
    "name": "Exo"
  },
  "engines": {
    "exo": ">=0.3.0"
  },
  "runtime": {
    "entry": "plugin.html"
  },
  "permissions": ["workspace:read", "workspace:write", "workspace:list", "events:subscribe"],
  "contributes": {
    "panels": [
      {
        "id": "fixture-panel",
        "title": "Fixture Panel",
        "icon": "list-tree",
        "location": "primary",
        "entry": "view-primary.html"
      },
      {
        "id": "fixture-inspector",
        "title": "Fixture Inspector",
        "icon": "inspect",
        "location": "secondary",
        "entry": "view-secondary.html"
      }
    ],
    "contentViews": [
      { "id": "fixture-tutorial", "title": "Fixture Tutorial", "entry": "view-content.html" }
    ],
    "configuration": {
      "properties": {
        "fixture.greeting": {
          "type": "string",
          "default": "hello from fixture",
          "description": "Text the fixture reports in its observation."
        },
        "fixture.repeat": {
          "type": "boolean",
          "default": false,
          "description": "Whether the fixture should keep its repeated-read mode enabled."
        },
        "fixture.size": {
          "type": "number",
          "enum": [1, 2, 3],
          "default": 1,
          "description": "A numeric enum used by the settings checks."
        }
      }
    },
    "fileEditors": [
      {
        "glob": "**/*.local.txt",
        "entry": "editor-local-events.html",
        "label": "Fixture Local Events",
        "priority": 60,
        "rendering": "frame"
      },
      {
        "glob": "**/*.list.txt",
        "entry": "editor-list.html",
        "label": "Fixture Listing",
        "priority": 50
      },
      {
        "glob": "**/*.picker.txt",
        "entry": "editor-picker.html",
        "label": "Fixture Picker",
        "priority": 40,
        "rendering": "frame"
      },
      {
        "glob": "**/*.events.txt",
        "entry": "editor-events.html",
        "label": "Fixture Events",
        "priority": 30
      },
      {
        "glob": "**/*.repeat.txt",
        "entry": "editor-repeat.html",
        "label": "Fixture Repeat",
        "priority": 20
      },
      {
        "glob": "**/*.append.txt",
        "entry": "editor-append.html",
        "label": "Fixture Append",
        "priority": 20
      },
      {
        "glob": "**/*.neverack.txt",
        "entry": "editor-never-ack.html",
        "label": "Fixture NeverAck",
        "priority": 20
      },
      {
        "glob": "**/*.txt",
        "entry": "editor.html",
        "label": "Fixture Text",
        "priority": 0
      },
      {
        "glob": "**/*.sibling.txt",
        "entry": "sibling.html",
        "label": "Fixture Sibling",
        "priority": 5
      }
    ]
  }
}
