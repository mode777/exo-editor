{
  "name": "@exo/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:codicons": "node scripts/copy-codicons.mjs",
    "dev": "npm run prepare:codicons && vite",
    "dev:plugin": "node scripts/serve-plugin-fixture.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "budget": "npm run build && node scripts/check-bundle-budget.mjs",
    "check:dist-csp": "node scripts/check-dist-csp.mjs dist/index.html",
    "check:dist-elements": "node scripts/check-dist-elements.mjs dist",
    "build": "npm run prepare:codicons && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@stratofold/client": "0.12.0",
    "@vscode-elements/elements": "^2.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6",
    "vscode-workbench": "~0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@exo/plugin-sdk": "1.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/codicons": "~0.0.44",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
