{
  "schemaVersion": 1,
  "id": "com.exo.code",
  "name": "Exo Code",
  "version": "0.1.0",
  "description": "Monaco-based reference code editor built with @exo/plugin-sdk.",
  "publisher": {
    "name": "Exo"
  },
  "homepage": "https://mode777.github.io/exo-editor/",
  "license": "MIT",
  "engines": {
    "exo": ">=0.1.0"
  },
  "runtime": {
    "entry": "plugin.html"
  },
  "permissions": ["workspace:read", "workspace:write", "events:subscribe"],
  "contributes": {
    "fileEditors": [
      {
        "glob": "**/*.{ts,tsx}",
        "entry": "editor.html",
        "label": "TypeScript",
        "priority": 10,
        "rendering": "frame"
      },
      {
        "glob": "**/*.{js,jsx}",
        "entry": "editor.html",
        "label": "JavaScript",
        "priority": 10,
        "rendering": "frame"
      },
      {
        "glob": "**/*.json",
        "entry": "editor.html",
        "label": "JSON",
        "priority": 10,
        "rendering": "frame"
      },
      {
        "glob": "**/*.md",
        "entry": "editor.html",
        "label": "Markdown",
        "priority": 10,
        "rendering": "frame"
      }
    ]
  }
}
